# archive_schema puts the archive tables elsewhere
statement ok
CREATE BRANCH elsewhere

statement ok
SET BRANCH elsewhere

statement ok
INSERT INTO untouched VALUES (1)

statement ok
SET BRANCH main

statement ok
UPDATE ducklake_meta.ducklake_branching_commit SET commit_time = NOW() - INTERVAL 40 DAY WHERE branch_id = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'elsewhere')

query III
SELECT branch_name, status, [regexp_replace(x, '__[0-9]{8}', '__DATE') FOR x IN archived_tables] FROM ducklake_close_stale_branches('ducklake', older_than => NOW() - INTERVAL 30 DAY, archive_schema => 'attic')
----
elsewhere	closed	[attic.elsewhere__untouched__DATE]

query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'ducklake' AND schema_name = 'attic'
