# where the call is refused
statement error
CALL ducklake_close_stale_branches('ducklake')
----
ducklake_close_stale_branches requires older_than

statement error
CALL ducklake_close_stale_branches('ducklake', older_than => NOW(), archive_schema => NULL)
----
archive_schema cannot be NULL or empty

statement ok
SET BRANCH fresh

statement error
CALL ducklake_close_stale_branches('ducklake', older_than => NOW())
----
Cannot close branches while on a branch - run SET BRANCH main first

statement ok
SET BRANCH main

statement ok
BEGIN

statement error
CALL ducklake_close_stale_branches('ducklake', older_than => NOW())
----
ducklake_close_stale_branches cannot be used inside an explicit transaction

statement ok
ROLLBACK

# while branches are open, merging adjacent files leaves the files they read at their fork alone
statement ok
CALL ducklake_merge_adjacent_files('ducklake')

query I
SELECT COUNT(*) > 1 FROM ducklake_meta.ducklake_data_file WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 't' AND end_snapshot IS NULL) AND end_snapshot IS NULL
----
true

# closing every branch lets it merge them
query II
SELECT branch_name, status FROM ducklake_close_stale_branches('ducklake', older_than => NOW() + INTERVAL 1 DAY)
----
fresh	closed
revived	closed

statement ok
CALL ducklake_merge_adjacent_files('ducklake')

query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_data_file WHERE table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 't' AND end_snapshot IS NULL) AND end_snapshot IS NULL
----
1

# a branch that cannot be read, or whose archive fails, is skipped and stays open; the others are closed (removing a
# snapshot by hand breaks every branch forked before it)
statement ok
CREATE BRANCH lost

statement ok
SET BRANCH lost

statement ok
INSERT INTO t VALUES (9, 'i')

statement ok
SET BRANCH main

statement ok
INSERT INTO t VALUES (10, 'j')

statement ok
CREATE BRANCH broken

statement ok
CREATE BRANCH kept

statement ok
SET BRANCH broken

statement ok
INSERT INTO t VALUES (11, 'k')

statement ok
SET BRANCH kept

statement ok
INSERT INTO t VALUES (12, 'l')

statement ok
SET BRANCH main

statement ok
UPDATE ducklake_meta.ducklake_branching_commit SET commit_time = NOW() - INTERVAL 40 DAY WHERE branch_id IN (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name IN ('lost', 'broken', 'kept'))

statement ok
SET VARIABLE lost_fork = (SELECT fork_snapshot_id FROM ducklake_branches('ducklake') WHERE branch_name = 'lost')

statement ok
DELETE FROM ducklake_meta.ducklake_snapshot WHERE snapshot_id = getvariable('lost_fork')

statement ok
UPDATE ducklake_meta.ducklake_branching_data_file SET path = path || '.missing' WHERE branch_id = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'broken')

query IIII
SELECT branch_name, status, len(archived_tables), CASE branch_name WHEN 'lost' THEN message = 'Cannot merge branch "lost": its fork snapshot ' || getvariable('lost_fork') || ' was expired' WHEN 'broken' THEN message LIKE '%.missing%' ELSE message IS NULL END FROM ducklake_close_stale_branches('ducklake', older_than => NOW() - INTERVAL 30 DAY)
----
lost	skipped	0	true
broken	skipped	0	true
kept	closed	1	true

query I
SELECT branch_name FROM ducklake_branches('ducklake') ORDER BY branch_id
----
lost
broken

# nothing of the failed archive is kept
query I
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'ducklake' AND table_name LIKE 'broken%'
----
0

statement ok
DROP BRANCH lost

statement ok
DROP BRANCH broken

