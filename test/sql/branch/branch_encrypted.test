# name: test/sql/branch/branch_encrypted.test
# description: branch files on an encrypted DuckLake keep their encryption keys across commits and reloads
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

# the crypto backend does not matter here, only that keys survive a branch commit and a reload
statement ok
SET force_mbedtls_unsafe = 'true'

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/branch_encrypted_files', METADATA_CATALOG 'ducklake_meta', ENCRYPTED, DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t VALUES (1), (2), (3)

statement ok
CREATE BRANCH b

statement ok
SET BRANCH b

statement ok
INSERT INTO t VALUES (10)

statement ok
DELETE FROM t WHERE i = 2

statement ok
UPDATE t SET i = 100 WHERE i = 10

query I
SELECT i FROM t ORDER BY i
----
1
3
100

query II
SELECT COUNT(*), COUNT(*) FILTER (encryption_key IS NOT NULL) FROM ducklake_meta.ducklake_branching_data_file
----
2	2

query II
SELECT COUNT(*), COUNT(*) FILTER (encryption_key IS NOT NULL) FROM ducklake_meta.ducklake_branching_delete_file
----
2	2

statement ok
USE memory

statement ok
DETACH ducklake

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/branch_encrypted_files', METADATA_CATALOG 'ducklake_meta', ENCRYPTED, DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
SET BRANCH b

query I
SELECT i FROM t ORDER BY i
----
1
3
100

statement ok
SET BRANCH main

query I
SELECT i FROM t ORDER BY i
----
1
2
3
