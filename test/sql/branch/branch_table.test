# name: test/sql/branch/branch_table.test
# description: ducklake_branch_table reads a table as a branch has it, with main's row ids, from main or another branch
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/branch_table_files', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE t(a INTEGER, b INTEGER)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20), (3, 30)

statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.big AS SELECT range AS i FROM range(3000)

statement ok
CREATE VIEW v AS SELECT 1 AS one

statement ok
CREATE BRANCH x

statement ok
SET BRANCH x

statement ok
UPDATE t SET b = 200 WHERE a = 2

statement ok
DELETE FROM t WHERE a = 3

statement ok
INSERT INTO t VALUES (4, 40)

statement ok
ALTER TABLE t ADD COLUMN c VARCHAR DEFAULT 'none'

statement ok
CREATE TABLE created AS SELECT 7 AS seven

statement ok
DELETE FROM s.big WHERE i >= 1000

statement ok
SET BRANCH main

statement ok
UPDATE t SET b = 111 WHERE a = 1

# from main: the branch's rows and columns, with main's row ids; a row the branch inserted has none
query IIIT
SELECT rowid, a, b, c FROM ducklake_branch_table('ducklake', 'x', 't') ORDER BY a
----
0	1	10	none
1	2	200	none
NULL	4	40	none

# joined with main's rows by row id: main's and the branch's values side by side
query IIII
SELECT m.a, m.b, br.b, m.rowid FROM t m JOIN ducklake_branch_table('ducklake', 'x', 't') br ON m.rowid = br.rowid ORDER BY m.a
----
1	111	10	0
2	20	200	1

# rows main has that the branch deleted
query I
SELECT a FROM t WHERE rowid NOT IN (SELECT rowid FROM ducklake_branch_table('ducklake', 'x', 't') WHERE rowid IS NOT NULL) ORDER BY a
----
3

# a manual merge of the rows only the branch changed: copy its values onto main, then the merge finds them the same
statement ok
UPDATE t SET b = br.b FROM ducklake_branch_table('ducklake', 'x', 't') br WHERE t.rowid = br.rowid AND t.a = 2

query II
FROM t ORDER BY a
----
1	111
2	200
3	30

query IIT
SELECT rowid, a, merge_status FROM ducklake_merge_branch('ducklake', 'x', dry_run => true, table_name => 't') WHERE change_type = 'update_postimage'
----
1	2	same as main

# more rows than one chunk, another schema, a table the branch created, and main itself
query II
SELECT COUNT(*), MAX(i) FROM ducklake_branch_table('ducklake', 'x', 'big', schema => 's')
----
1000	999

query II
SELECT rowid, seven FROM ducklake_branch_table('ducklake', 'x', 'created')
----
NULL	7

query I
SELECT COUNT(*) FROM ducklake_branch_table('ducklake', 'main', 'big', schema => 's')
----
3000

# from another branch
statement ok
CREATE BRANCH y

statement ok
SET BRANCH y

query II
SELECT COUNT(*), COUNT(rowid) FROM ducklake_branch_table('ducklake', 'x', 't')
----
3	2

statement ok
SET BRANCH main

# what cannot be read
statement error
FROM ducklake_branch_table('ducklake', 'x', 'missing')
----
Table "main.missing" does not exist on branch "x"

statement error
FROM ducklake_branch_table('ducklake', 'x', 'v')
----
"v" is a view, not a table

statement error
FROM ducklake_branch_table('ducklake', 'nope', 't')
----
Branch "nope" does not exist

statement error
FROM ducklake_branch_table('ducklake', NULL, 't')
----
Branch and table name cannot be NULL
