# name: test/sql/branch/branch_maintenance_concurrent.test
# description: a branch created while main merges adjacent files or flushes inlined rows makes that maintenance fail at commit, not lose what the branch reads
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/branch_maintenance_concurrent_files', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 10)

# two parquet files of t, and inlined rows of u
statement ok
CREATE TABLE ducklake.t(i INTEGER)

statement ok
INSERT INTO ducklake.t SELECT range FROM range(20)

statement ok
INSERT INTO ducklake.t SELECT range FROM range(20, 40)

statement ok
CREATE TABLE ducklake.u(i INTEGER)

statement ok
INSERT INTO ducklake.u VALUES (1), (2), (3)

# the compaction chooses both files of t while no branch exists - the branch tables don't exist yet either
statement ok con1
BEGIN

statement ok con1
CALL ducklake_merge_adjacent_files('ducklake')

statement ok con2
USE ducklake

statement ok con2
CREATE BRANCH b

statement ok con2
SET BRANCH b

statement ok con2
DELETE FROM t WHERE i = 1

statement error con1
COMMIT
----
Transaction conflict - a branch forked at snapshot

query II con2
SELECT COUNT(*), SUM(i) FROM t
----
39	779

# main's files are untouched, and the branch still merges
query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_data_file WHERE end_snapshot IS NULL AND table_id = (SELECT table_id FROM ducklake_meta.ducklake_table WHERE table_name = 't')
----
2

# the flush chooses u's inlined rows while only b is open, whose fork sees them - nothing is flushed
statement ok con2
SET BRANCH main

statement ok con2
DROP BRANCH b

statement ok con1
BEGIN

statement ok con1
CALL ducklake_flush_inlined_data('ducklake')

statement ok con2
CREATE BRANCH c

statement ok con2
SET BRANCH c

statement ok con2
DELETE FROM u WHERE i = 2

statement error con1
COMMIT
----
Transaction conflict - a branch forked at snapshot

query I con2
SELECT i FROM u ORDER BY i
----
1
3

statement ok con2
SET BRANCH main

statement ok con2
MERGE BRANCH c

query I con2
SELECT i FROM u ORDER BY i
----
1
3

# a non-adjacent rewrite is skipped, but a flush in the same transaction is still checked
statement ok
CREATE TABLE ducklake.rewrite_t AS SELECT range AS i FROM range(20)

statement ok
CREATE TABLE ducklake.flush_t(i INTEGER)

statement ok
INSERT INTO ducklake.flush_t VALUES (10), (20), (30)

statement ok con1
BEGIN

statement ok con1
CALL ducklake_rewrite_data_files('ducklake', 'rewrite_t', delete_threshold => 0)

statement ok con1
CALL ducklake_flush_inlined_data('ducklake', table_name => 'flush_t')

statement ok con2
CREATE BRANCH d

statement error con1
COMMIT
----
while flushing inlined rows it reads

statement ok con2
SET BRANCH d

query II con2
SELECT COUNT(*), SUM(i) FROM flush_t
----
3	60

statement ok con2
SET BRANCH main

statement ok con2
DROP BRANCH d

# with no branch open, both run as before
statement ok
CALL ducklake_merge_adjacent_files('ducklake')

statement ok
CALL ducklake_flush_inlined_data('ducklake')

query II
SELECT COUNT(*), SUM(i) FROM ducklake.t
----
40	780
