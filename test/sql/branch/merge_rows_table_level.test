# name: test/sql/branch/merge_rows_table_level.test
# description: tables main altered, renamed or compacted, and tables in nested schemas, keep the table-level rules when both sides changed their rows
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/merge_rows_table_level_files', METADATA_CATALOG 'ducklake_meta', DATA_INLINING_ROW_LIMIT 0)

statement ok
USE ducklake

statement ok
CREATE TABLE altered(i INTEGER)

statement ok
INSERT INTO altered VALUES (1), (2), (3)

statement ok
CREATE TABLE renamed(i INTEGER)

statement ok
INSERT INTO renamed VALUES (1), (2), (3)

statement ok
CREATE TABLE compacted(i INTEGER)

statement ok
INSERT INTO compacted VALUES (1), (2), (3)

statement ok
CREATE BRANCH b_altered

statement ok
CREATE BRANCH b_renamed

statement ok
CREATE BRANCH b_compacted

statement ok
SET BRANCH b_altered

statement ok
DELETE FROM altered WHERE i = 1

statement ok
SET BRANCH b_renamed

statement ok
DELETE FROM renamed WHERE i = 1

statement ok
SET BRANCH b_compacted

statement ok
DELETE FROM compacted WHERE i = 1

# main changes other rows of each table, then changes the table itself
statement ok
SET BRANCH main

statement ok
DELETE FROM altered WHERE i = 2

statement ok
ALTER TABLE altered ADD COLUMN j INTEGER

statement ok
DELETE FROM renamed WHERE i = 2

statement ok
ALTER TABLE renamed RENAME TO renamed_on_main

# the files main added since the fork are compacted; the file the branch reads at its fork is not, so DuckLake,
# which checks compactions per file, reports main's inserts as the conflict
statement ok
INSERT INTO compacted VALUES (4)

statement ok
INSERT INTO compacted VALUES (5)

statement ok
CALL ducklake_merge_adjacent_files('ducklake', 'compacted')

# the dry run reports the conflicts the merges below fail with, and marks the rows as table conflicts
query TTT
SELECT table_name, status, regexp_extract(conflict, 'another transaction has [a-z ]+') FROM ducklake_merge_branch('ducklake', 'b_altered', dry_run => true) UNION ALL SELECT table_name, status, regexp_extract(conflict, 'another transaction has [a-z ]+') FROM ducklake_merge_branch('ducklake', 'b_renamed', dry_run => true) UNION ALL SELECT table_name, status, regexp_extract(conflict, 'another transaction has [a-z ]+') FROM ducklake_merge_branch('ducklake', 'b_compacted', dry_run => true) ORDER BY 1
----
altered	conflict	another transaction has altered it
compacted	conflict	another transaction has inserted into it
renamed	conflict	another transaction has deleted from it

query IIII
FROM ducklake_merge_branch('ducklake', 'b_renamed', dry_run => true, table_name => 'renamed')
----
delete	0	table conflict	1

query IIII
FROM ducklake_merge_branch('ducklake', 'b_compacted', dry_run => true, table_name => 'compacted')
----
delete	0	table conflict	1

statement error
MERGE BRANCH b_altered
----
but another transaction has altered it

statement error
MERGE BRANCH b_renamed
----
but another transaction has deleted from it

statement error
MERGE BRANCH b_compacted
----
but another transaction has inserted into it

query II
FROM altered ORDER BY i
----
1	NULL
3	NULL

query I
FROM renamed_on_main ORDER BY i
----
1
3

query I
FROM compacted ORDER BY i
----
1
2
3
4
5

# nested schemas, on a lake with 1.1 metadata; main's delete is inlined unless inlining is off
statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}_nested' AS nested (DUCKLAKE_VERSION '1.1', DATA_PATH '{DATA_PATH}/merge_rows_table_level_nested_files', METADATA_CATALOG 'nested_meta')

statement ok
CREATE SCHEMA nested.outer_s

statement ok
CREATE SCHEMA nested.outer_s.inner_s

statement ok
CREATE TABLE nested.outer_s.inner_s.t AS SELECT range AS i FROM range(100)

statement ok
CALL ducklake_create_branch('nested', 'nb')

statement ok
CALL ducklake_set_branch('nested', 'nb')

statement ok
DELETE FROM nested.outer_s.inner_s.t WHERE i = 1

statement ok
CALL ducklake_set_branch('nested', 'main')

statement ok
DELETE FROM nested.outer_s.inner_s.t WHERE i = 2

# the dry run checks the branch's deletes against main's inlined ones, as the merge does
query TT
SELECT table_name, status FROM ducklake_merge_branch('nested', 'nb', dry_run => true)
----
t	conflict

statement error
CALL ducklake_merge_branch('nested', 'nb')
----
Transaction conflict

query I
SELECT COUNT(*) FROM nested.outer_s.inner_s.t
----
99

# a table with a column named rowid hides DuckDB's row id, so its rows can't be matched: table-level rules
statement ok
CREATE TABLE ducklake.rid(rowid INTEGER, v INTEGER)

statement ok
INSERT INTO ducklake.rid VALUES (0, 10), (5, 50)

statement ok
CALL ducklake_create_branch('ducklake', 'rb')

statement ok
UPDATE ducklake.rid SET rowid = 1 WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'rb')

statement ok
UPDATE ducklake.rid SET rowid = 2 WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'main')

statement error
CALL ducklake_merge_branch('ducklake', 'rb')
----
Transaction conflict

query II
SELECT rowid, v FROM ducklake.rid ORDER BY v
----
1	10
5	50

# so does a column named snapshot_id, filename or file_row_number, which the merge reads by name to locate rows:
# a snapshot_id column hid the rows both sides updated, and main got both copies
statement ok
CREATE TABLE ducklake.sid(snapshot_id INTEGER, v INTEGER)

statement ok
INSERT INTO ducklake.sid VALUES (7, 10), (7, 50)

statement ok
CALL ducklake_create_branch('ducklake', 'sb')

statement ok
UPDATE ducklake.sid SET snapshot_id = 8 WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'sb')

statement ok
UPDATE ducklake.sid SET snapshot_id = 9 WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'main')

statement error
CALL ducklake_merge_branch('ducklake', 'sb')
----
Transaction conflict

query II
SELECT snapshot_id, v FROM ducklake.sid ORDER BY v
----
8	10
7	50

# a filename column put the user's value where the branch's file path goes: the same update on both sides failed
# with an internal error
statement ok
CREATE TABLE ducklake.fn(filename VARCHAR, v INTEGER)

statement ok
INSERT INTO ducklake.fn VALUES ('a.csv', 10), ('b.csv', 50)

statement ok
CALL ducklake_create_branch('ducklake', 'fb')

statement ok
UPDATE ducklake.fn SET filename = 'same.csv' WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'fb')

statement ok
UPDATE ducklake.fn SET filename = 'same.csv' WHERE v = 10

statement ok
CALL ducklake_set_branch('ducklake', 'main')

statement error
CALL ducklake_merge_branch('ducklake', 'fb')
----
Transaction conflict

query II
SELECT filename, v FROM ducklake.fn ORDER BY v
----
same.csv	10
b.csv	50

# such a table still merges when only the branch changed it
statement ok
CREATE TABLE ducklake.frn(file_row_number INTEGER, v INTEGER)

statement ok
INSERT INTO ducklake.frn VALUES (1, 10)

statement ok
CALL ducklake_create_branch('ducklake', 'nb')

statement ok
CALL ducklake_set_branch('ducklake', 'nb')

statement ok
UPDATE ducklake.frn SET v = 11

statement ok
CALL ducklake_set_branch('ducklake', 'main')

statement ok
CALL ducklake_merge_branch('ducklake', 'nb')

query II
SELECT file_row_number, v FROM ducklake.frn
----
1	11

# a table main only renamed merges under the table-level rules, and the row view agrees with the summary
statement ok
CREATE TABLE ducklake.rename_only(i INTEGER)

statement ok
INSERT INTO ducklake.rename_only VALUES (1), (2), (3)

statement ok
CALL ducklake_create_branch('ducklake', 'b_rename_only')

statement ok
CALL ducklake_set_branch('ducklake', 'b_rename_only')

statement ok
DELETE FROM ducklake.rename_only WHERE i = 1

statement ok
INSERT INTO ducklake.rename_only VALUES (4)

statement ok
CALL ducklake_set_branch('ducklake', 'main')

statement ok
ALTER TABLE ducklake.rename_only RENAME TO rename_only_on_main

query II
SELECT table_name, status FROM ducklake_merge_branch('ducklake', 'b_rename_only', dry_run => true)
----
rename_only	ok

query III
SELECT change_type, merge_status, i FROM ducklake_merge_branch('ducklake', 'b_rename_only', dry_run => true, table_name => 'rename_only') ORDER BY i
----
delete	ok	1
insert	ok	4

statement ok
CALL ducklake_merge_branch('ducklake', 'b_rename_only')

query I
FROM ducklake.rename_only_on_main ORDER BY i
----
2
3
4
