statement ok
SET BRANCH missing_main_object

statement ok
DROP TABLE t

statement ok
SET BRANCH main

statement ok
SET VARIABLE missing_main_object = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'missing_main_object')

statement ok
CREATE BRANCH view_is_table

statement ok
SET BRANCH view_is_table

statement ok
DROP TABLE t

statement ok
SET BRANCH main

statement ok
SET VARIABLE view_is_table = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'view_is_table')

statement ok
CREATE BRANCH missing_parent_schema

statement ok
SET BRANCH missing_parent_schema

statement ok
CREATE SCHEMA s

statement ok
SET BRANCH main

statement ok
SET VARIABLE missing_parent_schema = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'missing_parent_schema')

statement ok
CREATE BRANCH missing_schema

statement ok
SET BRANCH missing_schema

statement ok
CREATE TABLE x(i INTEGER)

statement ok
SET BRANCH main

statement ok
SET VARIABLE missing_schema = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'missing_schema')

