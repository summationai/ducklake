SET BRANCH missing_next_column

statement ok
CREATE TABLE x(i INTEGER)

statement ok
SET BRANCH main

statement ok
SET VARIABLE missing_next_column = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'missing_next_column')

statement ok
CREATE BRANCH missing_parent_column

statement ok
SET BRANCH missing_parent_column

statement ok
CREATE TABLE x(s STRUCT(a INTEGER))

statement ok
SET BRANCH main

statement ok
SET VARIABLE missing_parent_column = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'missing_parent_column')

statement ok
CREATE BRANCH bad_nested_type

statement ok
SET BRANCH bad_nested_type

statement ok
CREATE TABLE x(s STRUCT(a INTEGER))

statement ok
SET BRANCH main

statement ok
SET VARIABLE bad_nested_type = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'bad_nested_type')

