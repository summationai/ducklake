# name: test/sql/branch/ddl_corruption.test
# description: damaged catalog rows of a branch are reported as an error and leave main and other branches usable
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ddl_corruption_files', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE TABLE t(i INTEGER)

statement ok
INSERT INTO t VALUES (1)

statement ok
CREATE BRANCH healthy

statement ok
SET BRANCH healthy

statement ok
CREATE TABLE fine AS SELECT 1 AS one

statement ok
SET BRANCH main

# every branch below gets one kind of damage
statement ok
CREATE BRANCH unknown_change

statement ok
SET BRANCH unknown_change

statement ok
DROP TABLE t

statement ok
SET BRANCH main

statement ok
SET VARIABLE unknown_change = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'unknown_change')

statement ok
CREATE BRANCH unknown_type

statement ok
SET BRANCH unknown_type

statement ok
CREATE TABLE x(i INTEGER)

statement ok
SET BRANCH main

statement ok
SET VARIABLE unknown_type = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'unknown_type')

statement ok
