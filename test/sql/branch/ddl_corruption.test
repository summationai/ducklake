statement ok
SET BRANCH orphan_column

statement ok
CREATE TABLE x(i INTEGER)

statement ok
SET BRANCH main

statement ok
SET VARIABLE orphan_column = (SELECT branch_id FROM ducklake_branches('ducklake') WHERE branch_name = 'orphan_column')

statement ok
