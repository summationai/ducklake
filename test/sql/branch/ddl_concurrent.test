# name: test/sql/branch/ddl_concurrent.test
# description: two connections changing the catalog of one branch - the second commit fails cleanly
# group: [branch]

require ducklake

require parquet

test-env DUCKLAKE_CONNECTION {TEST_DIR}/{BASE_TEST_NAME}.db

test-env DATA_PATH {TEST_DIR}

statement ok
ATTACH 'ducklake:{DUCKLAKE_CONNECTION}' AS ducklake (DATA_PATH '{DATA_PATH}/ddl_concurrent_files', METADATA_CATALOG 'ducklake_meta')

statement ok
USE ducklake

statement ok
CREATE TABLE t(i INTEGER)

statement ok
CREATE BRANCH b

statement ok con1
USE ducklake

statement ok con2
USE ducklake

statement ok con1
SET BRANCH b

statement ok con2
SET BRANCH b

statement ok con1
BEGIN

statement ok con2
BEGIN

statement ok con1
CREATE TABLE from_con1 AS SELECT 1 AS one

statement ok con2
CREATE TABLE from_con2 AS SELECT 2 AS two

statement ok con2
DROP TABLE t

statement ok con1
COMMIT

statement error con2
COMMIT
----
was changed or dropped by another transaction

# the failed commit left nothing behind
query II con2
SELECT schema_name, table_name FROM duckdb_tables() WHERE database_name = 'ducklake' ORDER BY ALL
----
main	from_con1
main	t

query I
SELECT COUNT(*) FROM glob('{DATA_PATH}/ddl_concurrent_files/main/from_con2/*')
----
0

query I
SELECT COUNT(*) FROM ducklake_meta.ducklake_branching_main_change
----
0

# a connection that read the branch before another one changed its catalog sees the change in its next transaction
statement ok con1
BEGIN

query I con1
SELECT COUNT(*) FROM from_con1
----
1

statement ok con2
ALTER TABLE from_con1 ADD COLUMN added INTEGER DEFAULT 3

query I con1
SELECT COUNT(*) FROM duckdb_tables() WHERE database_name = 'ducklake' AND table_name = 'from_con1'
----
1

statement ok con1
COMMIT

query II con1
FROM from_con1
----
1	3

# the retry succeeds
statement ok con2
CREATE TABLE from_con2 AS SELECT 2 AS two

query I con1
FROM from_con2
----
2
