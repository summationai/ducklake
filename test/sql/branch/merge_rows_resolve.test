# the conflicts: what each side did to each row
query ITTT
FROM ducklake_merge_branch('ducklake', 'bf', dry_run => true, table_name => 't_fail', conflicts_only => true)
----
0	update	update	conflict
1	update	delete	conflict
2	delete	update	conflict

# their values side by side: the branch's from ducklake_branch_table, main's from the table, matched on rowid
query ITTII
SELECT c.rowid, c.branch_change, c.main_change, br.price, m.price
FROM ducklake_merge_branch('ducklake', 'bf', dry_run => true, table_name => 't_fail', conflicts_only => true) c
LEFT JOIN ducklake_branch_table('ducklake', 'bf', 't_fail') br ON br.rowid = c.rowid
LEFT JOIN t_fail m ON m.rowid = c.rowid
ORDER BY c.rowid
----
0	update	update	10	11
1	update	delete	20	NULL
2	delete	update	NULL	33

statement error
MERGE BRANCH bf
----
changed 3 row(s) of table "t_fail" differently since the fork (rowid 0, 1, 2). ducklake_merge_branch('ducklake', 'bf', dry_run => true, table_name => 't_fail', conflicts_only => true) lists them. Keep one side with ON CONFLICT KEEP MAIN or KEEP BRANCH, or merge them by hand: update main's rows from ducklake_branch_table('ducklake', 'bf', 't_fail'), matching on rowid, then MERGE BRANCH with ON CONFLICT KEEP MAIN

# on_conflict in the dry run: the table merges, and each conflicting row says who wins
query TTT
SELECT table_name, status, conflict FROM ducklake_merge_branch('ducklake', 'bm', dry_run => true, on_conflict => 'main') ORDER BY table_name
----
m_main	ok	NULL
t_main	ok	NULL

query TTI
SELECT change_type, merge_status, COUNT(*) FROM ducklake_merge_branch('ducklake', 'bm', dry_run => true, table_name => 't_main', on_conflict => 'main') GROUP BY ALL ORDER BY ALL
----
delete	main wins	1
update_postimage	main wins	2
update_postimage	ok	1
update_preimage	main wins	2
update_preimage	ok	1

query ITT
SELECT rowid, branch_change, resolution FROM ducklake_merge_branch('ducklake', 'bb', dry_run => true, table_name => 't_branch', conflicts_only => true, on_conflict => 'branch') ORDER BY rowid
----
0	update	branch wins
1	update	branch wins
2	delete	branch wins

# keep main: main's version of each conflicting row stays, the rest of the branch merges
statement ok
MERGE BRANCH bm ON CONFLICT KEEP MAIN

query TI
FROM t_main ORDER BY item
----
a	11
c	33
d	40
e	55
f	6

query TI
FROM m_main ORDER BY item
----
a	11
c	33

# keep branch: the branch's version replaces main's, its deletes included
query TTT
SELECT table_name, status, conflict FROM ducklake_merge_branch('ducklake', 'bb', dry_run => true, on_conflict => 'branch') ORDER BY table_name
----
m_branch	ok	NULL
t_branch	ok	NULL

statement ok
CALL ducklake_merge_branch('ducklake', 'bb', on_conflict => 'branch')

query TI
FROM t_branch ORDER BY item
----
a	10
b	20
d	40
e	55
f	6

query TI
FROM m_branch ORDER BY item
----
a	10
b	20

query II
SELECT (SELECT COUNT(*) = COUNT(DISTINCT rowid) FROM t_branch), (SELECT COUNT(*) = COUNT(DISTINCT rowid) FROM m_branch)
----
true	true

# the failed merge left its branch as it was; on_conflict also takes fail
statement error
CALL ducklake_merge_branch('ducklake', 'bf', on_conflict => 'fail')
----
changed 3 row(s) of table "t_fail" differently

query TI
FROM t_fail ORDER BY item
----
a	11
c	33
d	4
e	55
f	6

# what on_conflict and conflicts_only accept
statement error
CALL ducklake_merge_branch('ducklake', 'bf', on_conflict => 'theirs')
----
on_conflict must be 'fail', 'main' or 'branch', not 'theirs'

statement error
FROM ducklake_merge_branch('ducklake', 'bf', dry_run => true, conflicts_only => true)
----
conflicts_only is only valid with dry_run => true and table_name

statement error
MERGE BRANCH bf ON CONFLICT KEEP
----
Expected MAIN or BRANCH after KEEP

statement error
MERGE BRANCH bf ON KEEP MAIN
----
Expected CONFLICT KEEP after ON

# a merge by hand: main takes a value of its own for one row and the branch's version of the row it deleted, keeps
# its own change to the row the branch deleted, and then keeps main for the conflicts
statement ok
UPDATE t_fail SET price = 12 WHERE item = 'a'

statement ok
INSERT INTO t_fail SELECT item, price FROM ducklake_branch_table('ducklake', 'bf', 't_fail') WHERE rowid = 1

statement error
MERGE BRANCH bf
----
changed 3 row(s) of table "t_fail" differently since the fork (rowid 0, 1, 2)

statement ok
MERGE BRANCH bf ON CONFLICT KEEP MAIN

query TI
FROM t_fail ORDER BY item
----
a	12
b	20
c	33
d	40
e	55
f	6

# a table in another schema: the message names it
statement ok
CREATE SCHEMA s

statement ok
CREATE TABLE s.t(i INTEGER)

statement ok
INSERT INTO s.t VALUES (1)

statement ok
CREATE BRANCH bs

statement ok
SET BRANCH bs

statement ok
UPDATE s.t SET i = 2

statement ok
SET BRANCH main

statement ok
UPDATE s.t SET i = 3

statement error
MERGE BRANCH bs
----
ducklake_merge_branch('ducklake', 'bs', dry_run => true, table_name => 't', schema => 's', conflicts_only => true) lists them. Keep one side with ON CONFLICT KEEP MAIN or KEEP BRANCH, or merge them by hand: update main's rows from ducklake_branch_table('ducklake', 'bs', 't', schema => 's')

query I
SELECT i FROM ducklake_branch_table('ducklake', 'bs', 't', schema => 's')
----
2

statement ok
MERGE BRANCH bs ON CONFLICT KEEP MAIN

query I
FROM s.t
----
3

# a table that conflicts as a whole is not resolved row by row
statement ok
CREATE TABLE altered(i INTEGER)

statement ok
INSERT INTO altered VALUES (1), (2)

statement ok
CREATE BRANCH ba

statement ok
SET BRANCH ba

statement ok
UPDATE altered SET i = 10 WHERE i = 1

statement ok
SET BRANCH main

statement ok
UPDATE altered SET i = 20 WHERE i = 2

statement ok
ALTER TABLE altered ADD COLUMN j INTEGER

statement error
FROM ducklake_merge_branch('ducklake', 'ba', dry_run => true, table_name => 'altered', conflicts_only => true)
----
Table "altered" conflicts as a whole

statement error
MERGE BRANCH ba ON CONFLICT KEEP BRANCH
----
but another transaction has altered it

